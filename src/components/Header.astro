---
import { navItems } from "../data/site";

interface Props {
  /** Route of the current page, used to mark the active nav link. */
  active?: string;
}
const { active } = Astro.props;
---

<header class="site-header" id="header">
  <div class="wrap">
    <a class="brand" href="/">
      <span class="mark">
        <img class="mark-img mark-light" src="/emblem-light.png" alt="" width="44" height="44" aria-hidden="true" />
        <img class="mark-img mark-teal" src="/emblem-teal.png" alt="" width="44" height="44" aria-hidden="true" />
      </span>
      <span class="name">Lumen Skin &amp; Wellness<small>Scottsdale · AZ</small></span>
    </a>
    <nav class="nav" id="nav" aria-label="Primary">
      {
        navItems.map((item) => (
          <a
            class={item.href === active ? "lnk active" : "lnk"}
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
      <a class="btn" href="/contact/">Book a Consultation</a>
    </nav>
    <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav">
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </div>
</header>
