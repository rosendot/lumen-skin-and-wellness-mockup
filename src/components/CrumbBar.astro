---
/** Dark inner-page header band with a breadcrumb trail. */
interface Props {
  here: string;
  eyebrow: string;
  heading: string;
  lede: string;
}
const { here, eyebrow, heading, lede } = Astro.props;
---

<section class="crumb-bar">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <span class="here">{here}</span>
    </nav>
    <p class="eyebrow">{eyebrow}</p>
    <h1>{heading}</h1>
    <p class="lede">{lede}</p>
  </div>
</section>
