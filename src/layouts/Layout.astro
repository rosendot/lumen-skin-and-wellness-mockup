---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/tokens.css";
import "../styles/lumen.css";

interface Props {
  title: string;
  description?: string;
  /** Route of the current page, used to mark the active nav link. */
  active?: string;
}

const {
  title,
  description = "Medical-grade facials, injectables, massage, and results-driven skincare in Scottsdale, AZ — led by a licensed nurse practitioner.",
  active,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site)} />

    <!-- Brand icons — generated from the sun+drop mark by .brand/build-assets.mjs.
         Teal mark (reads on the white scrolled header); WebP web, PNG apple. -->
    <link rel="icon" type="image/webp" sizes="32x32" href="/favicon-32.webp" />
    <link rel="icon" type="image/webp" sizes="192x192" href="/icon-192.webp" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Header active={active} />
    <slot />
    <Footer />
    <script>
      import "../scripts/lumen.ts";
    </script>
  </body>
</html>
